{
  "name": "centralized-pos-sqlite",
  "version": "1.0.0",
  "description": "Centralized POS Application with SQLite, designed for Ubuntu Server & Windows Desktop (.exe)",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node src/server.js",
    "desktop": "electron desktop/main.js",
    "build:win": "electron-builder --win nsis --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:all": "electron-builder --win nsis portable --x64",
    "prod": "pm2 start ecosystem.config.js",
    "prod:stop": "pm2 stop pos-central",
    "prod:restart": "pm2 restart pos-central",
    "prod:logs": "pm2 logs pos-central",
    "seed": "node src/seed.js",
    "migrate": "node src/migrate.js",
    "db:vacuum": "node -e \"const db=require('./src/db');db.pragma('vacuum');console.log('✅ Database vacuum selesai!')\"",
    "db:optimize": "node -e \"const db=require('./src/db');db.pragma('optimize');console.log('✅ Database optimize selesai!')\"",
    "health": "node -e \"const h=require('http');h.get('http://localhost:3000/health',(r)=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>console.log(JSON.parse(d)))})\"",
    "test:hash": "node -e \"const c=require('crypto');const p=process.argv[2]||'test123';const s=c.randomBytes(16).toString('hex');const h=c.pbkdf2Sync(p,s,100000,64,'sha512').toString('hex');console.log('Password:',p);console.log('Salt:',s);console.log('Hash:',h);\""
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.poskasir.umkm",
    "productName": "POS Kasir Pintar UMKM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!dist/**"
    ],
    "win": {
      "icon": "desktop/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POS Kasir Pintar"
    }
  },
  "author": "Antigravity",
  "license": "ISC"
}
